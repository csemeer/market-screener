# Google Cloud Platform - Backend Environment Variables
# Copy this file to .env for GCP deployment

# Environment
NODE_ENV=production

# Server Configuration
PORT=3001

# CORS Configuration
# Replace with your actual frontend Cloud Run URL after deployment
CORS_ORIGIN=https://market-screener-frontend-xxxxxxxxxx-uc.a.run.app

# Database Configuration (if using Cloud SQL)
# Uncomment and configure if you're using a database
# DB_HOST=
# DB_PORT=5432
# DB_NAME=market_screener
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true

# Redis Configuration (if using Memorystore)
# Uncomment if you're using Redis for caching
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# API Keys (if needed for external data sources)
# Add your API keys for market data providers
# ALPHA_VANTAGE_API_KEY=
# YAHOO_FINANCE_API_KEY=
# IEX_CLOUD_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Google Cloud Specific
# These are automatically set by Cloud Run
# GCP_PROJECT=
# K_SERVICE=
# K_REVISION=
# K_CONFIGURATION=

# Application Settings
MAX_LOGS=1000
CIRCULAR_BUFFER_SIZE=1000
REQUEST_TIMEOUT=30000
RATE_LIMIT=100

# Feature Flags
ENABLE_LOGGER=true
ENABLE_CACHING=false
ENABLE_ANALYTICS=false
