# ========================================
# Server Configuration
# ========================================
PORT=3001
NODE_ENV=development

# ========================================
# Database
# ========================================
DATABASE_PATH=./data/market-screener.db

# ========================================
# Email Notifications - SendGrid (Recommended)
# ========================================
# Sign up: https://sendgrid.com/ (Free: 100 emails/day)
# Setup guide: docs/SENDGRID_SETUP.md
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@yourdomain.com
EMAIL_FROM_NAME=Market Screener Alerts

# ========================================
# Email Notifications - SMTP/Gmail (Alternative)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=your-email@gmail.com

# ========================================
# SMS & WhatsApp - Twilio
# ========================================
# Sign up: https://www.twilio.com/try-twilio
# Setup guide: docs/TWILIO_SETUP.md
# Cost: ~$0.01/SMS, ~$0.005/WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Sandbox (free testing): whatsapp:+14155238886
# Production: whatsapp:+your-number
TWILIO_WHATSAPP_NUMBER=

# ========================================
# Telegram Notifications
# ========================================
# Create bot via @BotFather on Telegram
# Setup guide: docs/TELEGRAM_SETUP.md
# 100% FREE - Unlimited messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ========================================
# Broker Integration - Zerodha Kite Connect
# ========================================
# Sign up: https://kite.trade/ (₹20/month)
# Setup guide: docs/BROKER_ADAPTERS.md
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# ZERODHA_ACCESS_TOKEN=

# ========================================
# Broker Integration - Upstox API v2
# ========================================
# Sign up: https://upstox.com/developer/ (Free)
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_ACCESS_TOKEN=

# ========================================
# Market Data APIs (Optional)
# ========================================
ALPHA_VANTAGE_API_KEY=
# Get free key: https://www.alphavantage.co/support/#api-key
# Free tier: 5 calls/min, 500 calls/day

FINNHUB_API_KEY=
# Get free key: https://finnhub.io/register
# Free tier: 60 calls/min

FINANCIAL_MODELING_PREP_API_KEY=
# Get free key: https://financialmodelingprep.com/developer/docs/
# Free tier: 250 calls/day

IEX_CLOUD_API_KEY=
# Get free key: https://iexcloud.io/
# Free tier: 50,000 messages/month

# ========================================
# Feature Flags
# ========================================
ENABLE_NOTIFICATIONS=true
ENABLE_LIVE_MONITORING=true
ENABLE_AUTO_SCAN=true

# ========================================
# Monitoring Configuration
# ========================================
LIVE_MONITORING_INTERVAL=30
MINIMUM_VOLUME=100000

# ========================================
# Logging
# ========================================
LOG_LEVEL=info
# Options: debug, info, warn, error

# ========================================
# Security
# ========================================
# Webhook signature verification
WEBHOOK_SECRET=your-webhook-secret-here

# ========================================
# Notes
# ========================================
# 1. Copy this file to .env
# 2. Fill in your API keys and credentials
# 3. Never commit .env to version control
# 4. See docs/ folder for detailed setup guides
# 5. Start with free tiers, upgrade as needed
