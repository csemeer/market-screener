PORT=3001
NODE_ENV=development

# ============= OPTIONAL API KEYS =============
# The app works without these (uses Yahoo Finance + mock data)
# Add these for enhanced data quality and higher rate limits

# Technical Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# Get free key: https://www.alphavantage.co/support/#api-key
# Free tier: 5 calls/min, 500 calls/day

FINNHUB_API_KEY=your_finnhub_key_here
# Get free key: https://finnhub.io/register
# Free tier: 60 calls/min

# Fundamental Data APIs (Optional - Yahoo Finance works well)
FINANCIAL_MODELING_PREP_API_KEY=your_fmp_key_here
# Get free key: https://financialmodelingprep.com/developer/docs/
# Free tier: 250 calls/day

IEX_CLOUD_API_KEY=your_iex_key_here
# Get free key: https://iexcloud.io/
# Free tier: 50,000 messages/month

# Production Enhancements
# - Database connection strings (PostgreSQL/MongoDB)
# - Redis connection for caching
# - WebSocket endpoints for real-time data
# - Webhook URLs for alerts
